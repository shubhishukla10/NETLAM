# Read the Verilog source file
read_verilog design/adder.v

# Set the top module (replace "my_design" with your actual top module name)
hierarchy -top adder8

# Perform synthesis to a gate-level netlist
proc;              # Convert processes (always blocks)
opt;               # Optimize the design
techmap;           # Generic technology mapping
abc -g AND,OR,XOR,NAND,NOR  # Map to standard cell library (replace with actual .lib)
clean;             # Cleanup

# Write the synthesized gate-level netlist
write_verilog -noattr bin/adder_gate.v
